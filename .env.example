# PayPal sandbox (never commit the real .env)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional. PayPal cannot reach localhost, so only set this after the hosted deploy.
PAYPAL_WEBHOOK_ID=

# payouts = real sandbox Payouts, ledger_only = Orders + internal ledger fallback
SETTLEMENT_MODE=payouts

# Sandbox Personal account that receives all payouts in the demo
PAYOUT_RECEIVER_EMAIL=

# Seeds the wallet and policy on reset
DEMO_MODE=true

# Backend
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./wallet.db

# Agent
ANTHROPIC_API_KEY=
